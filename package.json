{
  "name": "@lizethriveros/bcrp-cli",
  "version": "0.2.0",
  "description": "Agent-first CLI and MCP server for BCRP (Banco Central de Reserva del Perú) statistics",
  "keywords": [
    "bcrp",
    "peru",
    "central-bank",
    "exchange-rate",
    "inflation",
    "cli",
    "mcp",
    "ai-agents",
    "open-data"
  ],
  "homepage": "https://github.com/LizethRiveros/bcrp-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LizethRiveros/bcrp-cli.git"
  },
  "bugs": "https://github.com/LizethRiveros/bcrp-cli/issues",
  "author": "LizethRiveros",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "bcrp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target node --outfile dist/cli.js",
    "catalog": "bun scripts/build-catalog.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  }
}
